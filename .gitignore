# ── 빌드 산출물 ──
build/
.build/
bin/
obj/
Debug/
Release/
x64/
*.user
*.suo
.vs/
CMakeCache.txt
CMakeFiles/

# ── Android ──
.gradle/
.cxx/
local.properties
app/build/

# ── Xcode ──
DerivedData/
build_xcode/
build-ios-sim/
build-ios-device/
*.xcuserdatad
xcuserdata/
ModuleCache.noindex/
*.pcm

# ── macOS ──
.DS_Store

# ⚠️ sdk/ 는 커밋한다 — 이 레포는 엔진 소스 없이 빌드돼야 하므로
#    라이브러리와 런타임 에셋이 레포 안에 있어야 한다. (.gitignore 에 넣지 말 것)
#
# 예외: iOS 정적 라이브러리는 하나가 216MB 라 GitHub 파일 한도(100MB)를 넘는다.
#       Releases 에서 받아 아래 폴더에 풀어야 한다 — README 참조.
sdk/lib-ios-sim/
sdk/lib-ios-device/

# 엔진 models/ 를 통째로 복사하다 딸려온 대형 샘플 모델(51MB).
# 샘플을 돌리는 데 필요 없고 레포만 무거워진다.
sdk/models/Sponza/

# 라이선스 불명 모델 — 엔진이 models/ 를 통째로 복사해도 다시 들어오지 않게 (THIRD_PARTY_NOTICES.md 참고)
sdk/models/GearboxAssy.glb
sdk/models/2CylinderEngine.glb
sdk/models/2CylinderEngine.gltf

# 플러그인은 플러그인 레포가 빌드해서 여기로 떨군다 (sdk/ 가 호스트의 작업 디렉터리라
# 엔진이 sdk/plugins 를 훑는다). 산출물이라 커밋하지 않는다.
sdk/plugins/

# 설치 파일(.deb 등)은 레포에 들어갈 것이 아니다. models/ 에 받아 두면 SDK 배포 단계가
# models/ 를 통째로 복사하면서 샘플 레포까지 따라간다 — 실제로 184MB 짜리가 3벌 생겼다.
*.deb

# Claude Code 개인 설정
.claude/settings.local.json

# ── SDK 바이너리 (2026-09-28) ──
# 엔진을 Release 로 빌드하면 3dEngine 의 CMake 가 여기로 자동 복사한다(cmake/export_sdk_lib.cmake).
# 빌드하는 곳마다 다른 바이너리가 생겨 풀할 때마다 충돌했고, 커밋된 것이 엔진보다 낡은 일도 잦았다 → 추적하지 않는다.
# 헤더(sdk/include)·에셋은 계속 추적. 공개할 땐 GitHub Releases 첨부로 배포.
# 예외(2026-10-04): 공개용 스냅숏으로 Windows dll·lib 은 `git add -f` 로 한 번씩 올린다 — 평소 빌드 결과는 여전히 추적 안 함.
sdk/*.dylib
sdk/*.so
sdk/*.so.*
sdk/*.dll
sdk/*.lib
sdk/*.pdb
sdk/*.exp
sdk/lib-ios-*/
