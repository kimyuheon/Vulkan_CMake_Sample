<Window x:Class="VulkanCadWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VulkanCadWpf"
        Title="VulkanCAD — WPF 호스트" Height="740" Width="1120"
        Background="#1E1F22">

    <Window.Resources>
        <!-- 툴바 납작 버튼 -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="Background" Value="#2B2D31"/>
            <Setter Property="Foreground" Value="#E6E6E6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#3A3E44"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2D6CDF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 강조(primary) 버튼 -->
        <Style x:Key="ToolBtnAccent" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="Background" Value="#2D6CDF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- 섹션 라벨 -->
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7C818B"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="10,0,6,0"/>
        </Style>

        <!-- 구분선 -->
        <Style x:Key="VSep" TargetType="Border">
            <Setter Property="Width" Value="1"/>
            <Setter Property="Background" Value="#3A3E44"/>
            <Setter Property="Margin" Value="8,7"/>
        </Style>

        <!-- 메뉴바 다크 -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="#1E1F22"/>
            <Setter Property="Foreground" Value="#D8D8D8"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- 메뉴바 -->
        <Menu DockPanel.Dock="Top" Padding="4,2" FontSize="12.5">
            <MenuItem Header="파일(_F)" Foreground="#E6E6E6">
                <MenuItem Header="모두 지움" Foreground="#1B1B1B" Click="OnClearAll"/>
                <Separator/>
                <MenuItem Header="종료" Foreground="#1B1B1B" Click="OnExit"/>
            </MenuItem>
            <MenuItem Header="편집(_E)" Foreground="#E6E6E6">
                <MenuItem Header="실행 취소 (Undo)" Foreground="#1B1B1B" Click="OnUndo"/>
                <MenuItem Header="다시 실행 (Redo)" Foreground="#1B1B1B" Click="OnRedo"/>
                <Separator/>
                <MenuItem Header="전체 선택" Foreground="#1B1B1B" Click="OnSelectAll"/>
                <MenuItem Header="선택 삭제" Foreground="#1B1B1B" Click="OnDelete"/>
            </MenuItem>
            <MenuItem Header="뷰(_V)" Foreground="#E6E6E6">
                <MenuItem Header="정면" Foreground="#1B1B1B" Click="OnViewFront"/>
                <MenuItem Header="평면" Foreground="#1B1B1B" Click="OnViewTop"/>
                <MenuItem Header="Isometric" Foreground="#1B1B1B" Click="OnViewIso"/>
                <Separator/>
                <MenuItem Header="줌 맞춤" Foreground="#1B1B1B" Click="OnZoom"/>
                <MenuItem Header="투영 전환 (Ortho/Persp)" Foreground="#1B1B1B" Click="OnToggleProj"/>
            </MenuItem>
        </Menu>

        <!-- 툴바 -->
        <Border DockPanel.Dock="Top" Background="#232529" BorderBrush="#111214" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="8,7">
                <TextBlock Text="그리기" Style="{StaticResource GroupLabel}"/>
                <Button Content="큐브"     Style="{StaticResource ToolBtnAccent}" Click="OnAddCube"/>
                <Button Content="선"       Style="{StaticResource ToolBtn}" Click="OnLine"/>
                <Button Content="사각형"   Style="{StaticResource ToolBtn}" Click="OnRect"/>
                <Button Content="원"       Style="{StaticResource ToolBtn}" Click="OnCircle"/>
                <Button Content="폴리라인" Style="{StaticResource ToolBtn}" Click="OnPolyline"/>

                <Border Style="{StaticResource VSep}"/>
                <TextBlock Text="편집" Style="{StaticResource GroupLabel}"/>
                <Button Content="전체선택" Style="{StaticResource ToolBtn}" Click="OnSelectAll"/>
                <Button Content="삭제"     Style="{StaticResource ToolBtn}" Click="OnDelete"/>
                <Button Content="↶ Undo"   Style="{StaticResource ToolBtn}" Click="OnUndo"/>
                <Button Content="↷ Redo"   Style="{StaticResource ToolBtn}" Click="OnRedo"/>

                <Border Style="{StaticResource VSep}"/>
                <TextBlock Text="뷰" Style="{StaticResource GroupLabel}"/>
                <Button Content="정면"   Style="{StaticResource ToolBtn}" Click="OnViewFront"/>
                <Button Content="평면"   Style="{StaticResource ToolBtn}" Click="OnViewTop"/>
                <Button Content="Iso"    Style="{StaticResource ToolBtn}" Click="OnViewIso"/>
                <Button Content="줌맞춤" Style="{StaticResource ToolBtn}" Click="OnZoom"/>
                <Button Content="투영"   Style="{StaticResource ToolBtn}" Click="OnToggleProj"/>
            </StackPanel>
        </Border>

        <!-- 상태바 -->
        <Border DockPanel.Dock="Bottom" Background="#232529" BorderBrush="#111214" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,5">
                <TextBlock x:Name="InfoText" DockPanel.Dock="Right" Foreground="#8CB4FF" Text=""/>
                <TextBlock x:Name="StatusText" Foreground="#B8BCC4" Text="준비"/>
            </DockPanel>
        </Border>

        <!-- 좌: 정보, 우: Vulkan 렌더 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1E1F22" BorderBrush="#111214" BorderThickness="0,0,1,0">
                <StackPanel Margin="14">
                    <TextBlock Text="VulkanCAD" Foreground="#F0F0F0" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="WPF 호스트 샘플" Foreground="#7C818B" FontSize="11" Margin="0,1,0,0"/>
                    <Border Height="1" Background="#2E3136" Margin="0,12"/>
                    <TextBlock Text="조작" Foreground="#9AA0AA" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock Foreground="#B8BCC4" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="우클릭 드래그 — 회전&#x0a;중클릭 드래그 — 팬&#x0a;휠 — 줌&#x0a;좌클릭 — 선택"/>
                    <Border Height="1" Background="#2E3136" Margin="0,12"/>
                    <TextBlock Text="씬" Foreground="#9AA0AA" FontSize="11" FontWeight="SemiBold"/>
                    <TextBlock x:Name="SceneInfo" Foreground="#8CB4FF" FontSize="12.5" Margin="0,4,0,0" Text="객체 0 · 선택 0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" x:Name="RenderHost" Background="Black"/>
        </Grid>
    </DockPanel>
</Window>
