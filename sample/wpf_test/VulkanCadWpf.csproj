<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 네이티브 VulkanCADCore.dll 이 x64 이므로 프로세스도 x64 로 고정 -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>VulkanCadWpf</AssemblyName>
    <RootNamespace>VulkanCadWpf</RootNamespace>
  </PropertyGroup>

  <!--
    실행하려면 다음 파일들이 출력 폴더(bin\x64\Debug\net8.0-windows)에 있어야 함:
      - VulkanCADCore.dll          (C++ VulkanCADCoreShared 타겟 산출물)
      - shaders/ models/ textures/ fonts/   (런타임 에셋)
    아래 Target 이 C++ 빌드 출력(..\..\build\Debug)에서 자동 복사 시도.
    경로가 다르면 CadCoreBuildDir 프로퍼티를 조정하거나 수동 복사.
  -->
  <PropertyGroup>
    <CadCoreBuildDir>$(MSBuildProjectDirectory)\..\..\sdk</CadCoreBuildDir>
  </PropertyGroup>

  <Target Name="CopyCadCoreRuntime" AfterTargets="Build"
          Condition="Exists('$(CadCoreBuildDir)\VulkanCADCore.dll')">
    <ItemGroup>
      <CadDll       Include="$(CadCoreBuildDir)\VulkanCADCore.dll" />
      <ShaderFiles  Include="$(CadCoreBuildDir)\shaders\**\*" />
      <ModelFiles   Include="$(CadCoreBuildDir)\models\**\*" />
      <TextureFiles Include="$(CadCoreBuildDir)\textures\**\*" />
      <FontFiles    Include="$(CadCoreBuildDir)\fonts\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(CadDll)"       DestinationFolder="$(OutDir)"                          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ShaderFiles)"  DestinationFolder="$(OutDir)shaders\%(RecursiveDir)"   SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ModelFiles)"   DestinationFolder="$(OutDir)models\%(RecursiveDir)"    SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TextureFiles)" DestinationFolder="$(OutDir)textures\%(RecursiveDir)"  SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FontFiles)"    DestinationFolder="$(OutDir)fonts\%(RecursiveDir)"     SkipUnchangedFiles="true" />
  </Target>

</Project>
