<Project Sdk="Microsoft.NET.Sdk">

  <!--
    갤러리 기능 모음. 기능 하나 = Features/ 의 파일 하나.
    화면(WinForms/WPF)을 모르므로 두 갤러리가 이 프로젝트를 그대로 같이 쓴다.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <!-- 솔루션으로 빌드해도 bin\x64\ 가 아니라 bin\Release\ 로 — 어디서 빌드하든 exe 위치가 같게 -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <RootNamespace>VulkanCAD.Gallery</RootNamespace>
    <AssemblyName>VulkanCAD.Gallery.Features</AssemblyName>
  </PropertyGroup>

  <!--
    엔진 C API 의 C# 선언 — 엔진 빌드가 sdk/csharp 에 만들어 준다(헤더와 같은 급).
    여러분의 앱에서도 이 두 줄이면 된다: sdk/csharp/*.cs 를 프로젝트에 포함.
  -->
  <PropertyGroup>
    <VulkanCadSdk>$(MSBuildThisFileDirectory)..\..\..\..\sdk</VulkanCadSdk>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(VulkanCadSdk)\csharp\*.cs" Link="sdk\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
