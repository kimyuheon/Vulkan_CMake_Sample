<Project>

  <!--
    빌드가 끝나면 sdk/ 의 엔진 DLL 과 런타임 에셋을 출력 폴더(exe 옆)로 복사한다.
    엔진은 exe 폴더를 에셋 경로로 쓰므로(CAD_SetRuntimeAssetPath) 이 폴더들이 exe 옆에 있어야 한다.
    WinForms·WPF 갤러리가 같이 가져다 쓴다.
  -->
  <PropertyGroup>
    <VulkanCadSdk Condition="'$(VulkanCadSdk)' == ''">$(MSBuildThisFileDirectory)..\..\..\sdk</VulkanCadSdk>
  </PropertyGroup>

  <Target Name="CopyVulkanCadRuntime" AfterTargets="Build">
    <Error Condition="!Exists('$(VulkanCadSdk)\VulkanCADCore.dll')"
           Text="sdk\VulkanCADCore.dll 이 없습니다. 엔진을 Release 로 빌드하거나 GitHub Releases 에서 받아 sdk\ 에 두세요." />
    <ItemGroup>
      <_CadAssetDir Include="models;textures;fonts;effects;languages" />
    </ItemGroup>
    <Copy SourceFiles="$(VulkanCadSdk)\VulkanCADCore.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <!-- 폴더마다 MSBuild 를 한 번씩 불러 하위 구조(RecursiveDir)를 그대로 복사 -->
    <MSBuild Projects="$(MSBuildThisFileFullPath)" Targets="_CopyCadAssetDir"
             Properties="Sdk=$(VulkanCadSdk);Dir=%(_CadAssetDir.Identity);Out=$(TargetDir)" />
  </Target>

  <Target Name="_CopyCadAssetDir">
    <ItemGroup>
      <_F Include="$(Sdk)\$(Dir)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_F)" DestinationFolder="$(Out)$(Dir)\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
