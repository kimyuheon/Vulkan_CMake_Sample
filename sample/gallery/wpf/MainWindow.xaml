<Window x:Class="VulkanCAD.Gallery.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VulkanCAD.Gallery.Wpf"
        Title="VulkanCAD 기능 갤러리 — WPF" Width="1680" Height="960"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="Malgun Gothic" FontSize="12.5">

    <!-- 위 리본 · 가운데 엔진 화면 · 오른쪽 기능 패널 · 아래 상태줄 -->
    <DockPanel>
        <local:RibbonBar x:Name="Ribbon" DockPanel.Dock="Top" />

        <Border DockPanel.Dock="Bottom" Height="26" Background="{StaticResource MenuBar}" Padding="10,0">
            <DockPanel>
                <TextBlock x:Name="Counts" DockPanel.Dock="Right" Foreground="{StaticResource TextCode}" VerticalAlignment="Center" />
                <TextBlock x:Name="Status" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <local:FeaturePanel x:Name="Panel" DockPanel.Dock="Right" Width="350" />
        <Border DockPanel.Dock="Right" Width="1" Background="{StaticResource Border}" />

        <!-- 왼쪽: 노드 트리 · 도면층 (엔진 ImGui 패널은 임베드에서 안 뜨므로 호스트가 그린다) -->
        <local:ScenePanel x:Name="ScenePane" DockPanel.Dock="Left" Width="330" />
        <Border DockPanel.Dock="Left" Width="1" Background="{StaticResource Border}" />

        <local:VulkanHost x:Name="View" />
    </DockPanel>
</Window>
