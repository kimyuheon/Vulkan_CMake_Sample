<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- 네이티브 VulkanCADCore.dll 이 x64 이므로 프로세스도 x64 -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <!-- 솔루션으로 빌드해도 bin\x64\ 가 아니라 bin\Release\ 로 — 어디서 빌드하든 exe 위치가 같게 -->
    <AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
    <RootNamespace>VulkanCAD.Gallery.WinForms</RootNamespace>
    <AssemblyName>VulkanCAD.Gallery.WinForms</AssemblyName>
    <!-- 모니터별 DPI — 컨트롤 크기가 물리 픽셀이라 스왑체인 크기와 바로 맞는다 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\csharp\Gallery.Features\Gallery.Features.csproj" />
  </ItemGroup>

  <!-- 엔진 DLL 과 런타임 에셋을 sdk/ 에서 출력 폴더로 복사 -->
  <Import Project="..\csharp\CopySdkRuntime.targets" />

</Project>
